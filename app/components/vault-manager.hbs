<button
  type="button"
  class="btn btn-outline-secondary text-light p-0 border-0 rounded-0 btn-window"
  {{on "click" this.toggleModal}}
  title="Local settings"
>
  <FaIcon @icon={{if this.cryptoData.isUnlocked "unlock" "lock"}} />
</button>

{{#in-element this.modalWormhole insertBefore=null}}
  <BsModal
    @open={{this.showVaultModal}}
    @onHide={{this.continueLocked}}
    @backdrop={{true}}
    @keyboard={{false}}
    @size="md"
    as |Modal|
  >
    <BsForm @onSubmit={{this.submitForm}}  autoComplete="on" as |form|>
      <Modal.header @closeButton={{false}}>
        <h5 class="modal-title">{{this.title}}</h5>
      </Modal.header>
      <Modal.body>
        {{#if this.cryptoData.newVaultModal}}
          <p class="mb-2 text-break">It looks like you haven't set a passphrase yet.</p>
          <p class="mb-2 text-break">You can create one now to encrypt your chat clients and passwords, or continue without it and use Paperbot without encryption (not recommended).</p>
          <p class="mb-2 text-break">Once set, the app will ask you to enter your passphrase on every startup.</p>
        {{else}}
          {{#if this.isMigration}}
            <p class="mb-2 text-break">There is a remote security vault already configured. Because you created a new local security vault before syncing, now you have to pick which one to use and apply globally. Once done all devices will use the same security passphrase for encryption/decryption.</p>
            <p class="mb-2 text-break">Please enter both passwords to proceed with the migration.</p>
          {{else}}
            <p class="mb-2 text-break">Enter your passphrase to unlock your encrypted clients.</p>
          {{/if}}
        {{/if}}
        <label
          for="vault-unlock-username"
          class="visually-hidden"
        >Username</label>
        <input
          id="vault-unlock-username"
          type="text"
          name="username"
          autocomplete="username"
          value="vault"
          class="d-none"
          tabindex="-1"
          aria-hidden="true"
        />

        <form.element
          @controlType="password"
          @label="Passphrase"
          @property="passphrase"
          @onChange={{this.checkPassPhrase}}
          @disabled={{this.isMigrationForm}}
          as |el|
        >
          <el.control
            name="passphrase"
            autocomplete="passphrase"
            required
          />
        </form.element>
        {{#if (and this.errorMessages (not this.isMigrationForm))}}
          <div class="alert alert-danger py-2 mb-0">
            {{#each this.errorMessages as |error|}}
              <div>{{error}}</div>
            {{/each}}
          </div>
        {{/if}}
        {{#if this.isMigration}}
          <div class="row py-3">
            <div class="col-12 col-sm">
              <BsButton @type="primary" class="w-100" @onClick={{this.applyRemoteVault}}>
                Apply Remote Vault
              </BsButton>
            </div>
            <div class="col-12 col-sm">
              <BsButton @type="warning" class="w-100" @onClick={{this.applyLocalVault}}>
                Apply Local Vault
              </BsButton>
            </div>
          </div>
          {{#if this.isMigrationForm}}
              <label
                for="existing-vault-unlock-username"
                class="visually-hidden"
              >Username</label>
              <input
                id="existing-vault-unlock-username"
                type="text"
                name="username"
                autocomplete="username"
                value="vault"
                class="d-none"
                tabindex="-1"
                aria-hidden="true"
              />

              <form.element
                @controlType="password"
                @label="Remote Vault Passphrase"
                @property="remotePassphrase"
                @onChange={{this.checkRemotePassPhrase}}
                as |el|
              >
                <el.control
                  name="password"
                  autocomplete="remote-password"
                  required
                />
              </form.element>
              {{#if this.errorMessages}}
                <div class="alert alert-danger py-2 mb-0">
                  {{#each this.errorMessages as |error|}}
                    <div>{{error}}</div>
                  {{/each}}
                </div>
              {{/if}}
          {{/if}}
        {{/if}}
      </Modal.body>
      <Modal.footer>
        <BsButton @type="secondary" @onClick={{this.continueLocked}}>
          {{#if this.cryptoData.newVaultModal}}
            Cancel
          {{else}}
            Continue Locked
          {{/if}}
        </BsButton>
        <form.submitButton @type="primary" disabled={{this.invalidPassphrase}}>
          {{#if this.cryptoData.newVaultModal}}
            Encrypt my secrets
          {{else}}
            {{#if this.isMigrationForm}}Sync security{{else}}Unlock{{/if}}
          {{/if}}
        </form.submitButton>
      </Modal.footer>
    </BsForm>
  </BsModal>
{{/in-element}}