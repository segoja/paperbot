<BsButton
  @type="btn btn-outline-secondary text-black p-0 border-0 rounded-0 btn-window"
  @onClick={{this.toggleModal}}
  title={{this.cloudText}}
>
  <span class={{this.cloudColor}}><FaIcon
      @icon="cloud"
      class="svg-cloud"
      @size="lg"
    /></span>
  <div class="sync-activity mx-0">
    {{#if this.globalConfig.config.canConnect}}
      {{#unless this.showArrows}}
        <span class={{unless this.isCloudSynced "blinkcolor"}}><FaIcon
            @icon="long-arrow-alt-up"
            @size="sm"
          /></span>
        <span class={{unless this.isLocalSynced "blinkcolor"}}><FaIcon
            @icon="long-arrow-alt-down"
            @size="sm"
          /></span>
      {{/unless}}
    {{else}}
      <span class=""><FaIcon @icon="cancel" @size="sm" /></span>
    {{/if}}
  </div>
</BsButton>

{{#in-element this.modalWormhole insertBefore=null}}
  {{#if this.globalConfig.config}}
    <BsModal
      @size="lg"
      @open={{this.visible}}
      @onHide={{this.toggleModal}}
      as |Modal|
    >
      <Modal.header
        @closeButton={{false}}
        class="p-0 m-0 bg-dark border-0 border-bottom rounded-top"
      >
        <div class="row g-0 w-100">
          <div class="col py-1 ps-3"><span class="h5 text-white">Cloud Settings</span></div>
          <div class="col-auto">
            <button
              type="button"
              class="btn btn-dark rounded-0 rounded-top-right border-0"
              {{on "click" this.toggleModal}}
              title="Close"
            ><FaIcon @icon="times" /></button>
          </div>
        </div>
      </Modal.header>
      <Modal.body>
        <p>You can sync Paperbot among different devices using a self hosted or
          free third-party CouchDb database like
          <a
            href="https://www.cloudstation.com/en"
            target="_blank"
            rel="noopener noreferrer"
          >CloudStation</a>
          <span role="button" id="remote-couch-info">
            <FaIcon
              @icon="question-circle"
              class="text-info"
              role="presentation"
            />
          </span>
          <BsPopover
            @triggerEvents={{this.globalConfig.popoverevents}}
            @placement="bottom"
            @triggerElement="#remote-couch-info"
            @delayHide={{this.globalConfig.ttdelay}}
            class="ppover"
            as |po|
          >
            <div
              role="dialog"
              class="p-2 alert alert-dismissible m-0"
              {{on "mouseleave" po.close}}
            >
              <p>Songs, requests, commands, streams, clients and overlays will
                be synced, but not the bot settings, wich will stay in your
                device/browser only.</p>
              <p class="text-danger">If you use CloudStation make sure you
                uncheck the "Publicly accessible" checkbox when creating your
                database.</p>
            </div>
          </BsPopover>
        </p>

        <BsForm
          @formLayout="horizontal"
          @model={{this.globalConfig.config}}
          @onSubmit={{this.doneEditing}}
          autoComplete="off"
          as |form|
        >
          <div class="row pb-3">
            <form.element
              @controlType="power-select"
              @property="cloudType"
              @onChange={{this.setCloudType}}
              @formLayout="inline"
              class="col border-light"
              @allowClear={{true}}
              @options={{this.cloudTypes}}
              required
              as |type|
            >
              <type.control
                @placeholder="Select your cloud service"
                as |option|
              >
                {{option}}
              </type.control>
            </form.element>
          </div>
          {{#if this.globalConfig.config.isCustomCloud}}
            <div class="row pb-3">
              <div class="col">
                <EncryptedFormControl
                  @size="sm"
                  @preIcon="link"
                  @class={{if this.cloudState.isCloudError "is-invalid"}}
                  @label="Remote url"
                  @placeholder="Enter remote url"
                  @title="Show remote url"
                  @autocomplete="cloud-url"
                  @isFormGroup={{false}}
                  @value={{this.globalConfig.config.remoteUrl}}
                  @onChange={{fn (mut this.globalConfig.config.remoteUrl)}}
                  @updateTrigger={{this.globalConfig.config.rev}}
                  @disabled={{this.cloudState.isCloudDisabled}}
                />
              </div>
            </div>
          {{/if}}
          <div class="row pb-3">
            <div class="col">
              <EncryptedFormControl
                @size="sm"
                @preIcon="user"
                @class={{if this.cloudState.isCloudError "is-invalid"}}
                @label="Username"
                @placeholder="Enter remote username"
                @title="Show username"
                @autocomplete="cloud-username"
                @isFormGroup={{false}}
                @value={{this.globalConfig.config.username}}
                @onChange={{fn (mut this.globalConfig.config.username)}}
                @updateTrigger={{this.globalConfig.config.rev}}
                @disabled={{this.cloudState.isCloudDisabled}}
              />
            </div>
            <div class="col">
              <EncryptedFormControl
                @size="sm"
                @preIcon="key"
                @class={{if this.cloudState.isCloudError "is-invalid"}}
                @label="Password"
                @placeholder="Enter remote password"
                @title="Show password"
                @autocomplete="cloud-password"
                @isFormGroup={{false}}
                @value={{this.globalConfig.config.password}}
                @onChange={{fn (mut this.globalConfig.config.password)}}
                @updateTrigger={{this.globalConfig.config.rev}}
                @disabled={{this.cloudState.isCloudDisabled}}
              />
            </div>
          </div>
          {{#unless this.globalConfig.config.isCustomCloud}}
            <div class="row pb-3">
              <div class="col">
                <EncryptedFormControl
                  @size="sm"
                  @preIcon="database"
                  @class={{if this.cloudState.isCloudError "is-invalid"}}
                  @label="Database name"
                  @placeholder="Enter database name"
                  @title="Show database name"
                  @autocomplete="cloud-database"
                  @isFormGroup={{false}}
                  @value={{this.globalConfig.config.database}}
                  @onChange={{fn (mut this.globalConfig.config.database)}}
                  @updateTrigger={{this.globalConfig.config.rev}}
                  @disabled={{this.cloudState.isCloudDisabled}}
                />
              </div>
            </div>
          {{/unless}}
          <div class="row">
            <div class="col">
              <form.element
                @controlType="checkbox"
                @label="Auto-connect"
                @formLayout="inline"
                class="form-check form-check-inline ps-0 mb-0 pt-2"
                @property="autoConnect"
                required
              />
            </div>
          </div>
          {{#if this.cloudState.isCloudError}}
            <div class="row">
              <div class="col">
                {{#if this.cloudState.isConnError}}
                  <div class="alert alert-danger py-0 px-2"><small>The
                      connection to the server failed. Check
                      {{if
                        this.globalConfig.config.isCustomCloud
                        "remote url"
                        "database name"
                      }}
                      and login credentials.</small></div>
                {{/if}}
                {{#if this.cloudState.isCouchError}}
                  <div class="alert alert-danger py-0 px-2"><small>You connected
                      to the server but the database doest not exist. Check
                      database name.</small></div>
                {{/if}}
              </div>
            </div>
          {{/if}}
        </BsForm>
      </Modal.body>
      <Modal.footer class="py-2 row g-0 flex-nowrap">
        <div class="col">

          <BsButton
            @type={{if this.isOnline "danger" "secondary"}}
            class="btn-sm"
            @onClick={{this.toggleConnection}}
            title={{if
              this.isOnline
              "Disconnect from cloud"
              "Connect to cloud"
            }}
          >
            {{#if this.isOnline}}
              <span><FaIcon @icon="toggle-on" /> Disconnect</span>
            {{else}}
              <span><FaIcon @icon="toggle-off" /> Connect </span>
            {{/if}}
          </BsButton>
        </div>
        <div class="col-auto">
          <BsButton
            @type="success"
            @onClick={{this.doneEditing}}
            title={{if this.saving "Saving..." "Save"}}
          >
            {{#if this.saving}}
              <span><FaIcon @icon="spinner" class="spin" /> Saving...</span>
            {{else}}
              <span class="pe-3 me-1"><FaIcon @icon="save" /> Save</span>
            {{/if}}
          </BsButton>
        </div>
      </Modal.footer>
    </BsModal>
  {{/if}}
{{/in-element}}