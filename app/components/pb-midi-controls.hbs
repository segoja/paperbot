  <BsForm
    class="row g-0 bg-dark"
    @formLayout="horizontal"
    @model={{this.midi}}
    as |form|
  >
    <BsButton
      class="btn-sm col-auto text-truncate border rounded-0"
      @type={{if this.noFilters "secondary" "success"}}
      @onClick={{this.toggleMute}}
      disabled={{(not @isConnected)}}
      title="Toggle chords"
    >{{svg-jar "midi" class="svg-inline--fa" width="1em" fill="white"}} Midi</BsButton>
    <BsButton
      class="btn-sm col-auto text-truncate border rounded-0"
      @type={{if this.canChords "danger" "secondary"}}
      @onClick={{this.toggleChords}}
      disabled={{this.noFilters}}
      title="Toggle chords"
    >{{svg-jar "midi-chords" class="svg-inline--fa" width="1em"}} Chords</BsButton>
    <BsButton
      class="btn-sm col-auto text-truncate border rounded-0"
      @type={{if this.canNotes "danger" "secondary"}}
      @onClick={{this.toggleNotes}}
      disabled={{this.noFilters}}
      title="Toggle notes"
    >{{svg-jar "midi-notes" class="svg-inline--fa" width="1em"}}  Notes</BsButton>
    <form.element
      @controlType="power-select"
      @property="selectedKeyOption"
      @selected={{this.midi.selectedKeyOption}}
      @onChange={{this.setMidiKey}}
      @formLayout="inline"
      class="col border-light"
      @allowClear={{true}}
      @options={{this.midi.availableKeys}}
      required
      as |type|
    >
      <type.control
        @placeholder="Select key"
        as |option|
      >
        {{option}}
      </type.control>
    </form.element>
    <form.element
      @controlType="power-select"
      @property="selectedModeOption"
      @selected={{this.midi.selectedModeOption}}
      @onChange={{this.setMidiMode}}
      @formLayout="inline"
      class="col border-light"
      @allowClear={{true}}
      @options={{this.midi.availableModes}}
      required
      as |type|
    >
      <type.control
        @placeholder="Select mode"
        as |option|
      >
        {{option}}
      </type.control>
    </form.element>
    <form.element
      @controlType="power-select"
      @property="selectedChordOutputOption"
      @selected={{this.midi.selectedChordOutputOption}}
      @onChange={{this.setMidiChordsOutput}}
      @formLayout="inline"
      class="col border-light"
      @allowClear={{true}}
      @options={{this.midi.availableMidiOutputOptions}}
      required
      as |type|
    >
      <type.control
        @placeholder="Midi device for chords"
        as |option|
      >
        {{option.label}}
      </type.control>
    </form.element>
    <form.element
      @controlType="power-select"
      @property="selectedNoteOutputOption"
      @selected={{this.midi.selectedNoteOutputOption}}
      @onChange={{this.setMidiNotesOutput}}
      @formLayout="inline"
      class="col border-light"
      @allowClear={{true}}
      @options={{this.midi.availableMidiOutputOptions}}
      required
      as |type|
    >
      <type.control
        @placeholder="Midi device for notes"
        as |option|
      >
        {{option.label}}
      </type.control>
    </form.element>
  </BsForm>