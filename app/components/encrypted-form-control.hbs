<div class={{concat "input-group "this.groupClass}} {{did-insert this.updateValue}} {{did-update this.updateValue @updateTrigger this.cryptoData.isUnlocked  this.cryptoData.vault.rev}}>
  {{#if @preIcon}}
    <div class="input-group-text border-default">
      <FaIcon @icon={{@preIcon}} @size={{@size}} />
    </div>
  {{/if}}
  <Input
    @type={{if this.isMasked "password" "text"}}
    @value={{this.value}}
    aria-label={{this.label}}
    autocomplete={{this.autocomplete}}
    class={{this.inputClass}}
    disabled={{this.disabled}}
    placeholder={{this.placeholder}}
    {{on "keyup" this.onChange}}
  />
  <button
    type="button"
    class="btn btn-outline-secondary rounded-start-0"
    disabled={{@disabled}}
    title={{this.title}}
    {{on "click" this.toggleMask}}
  ><FaIcon @icon={{if this.isMasked "eye" "eye-slash"}} /></button>
</div>